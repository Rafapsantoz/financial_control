# Configurações Gerais
PROJECT_NAME="Financial Organizer API"
VERSION="1.0.0"
SECRET_KEY="sua-chave-secreta-jwt-aqui"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Chave da API do Google Gemini (obtenha gratuitamente em https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSy..."

# Banco de Dados
# Quando True: usa SQLite local (Zero-Configuração, não precisa instalar banco de dados)
# Quando False: conecta no PostgreSQL
USE_SQLITE=True
SQLITE_DB_PATH="./financial.db"

# PostgreSQL (utilizado apenas se USE_SQLITE=False)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="administrator"
POSTGRES_PASSWORD="admin_user"
POSTGRES_DB="appdb"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
